<Window x:Class="AttendanceBot.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AttendanceBot" Width="1100" Height="700" MinWidth="800" MinHeight="500" Background="#101827"><Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="AttendanceBot" Foreground="#80D8FF" FontSize="22" FontWeight="Bold" Margin="4,4,4,28"/><Button Content="Dashboard" Click="NavigateClick" Tag="Dashboard"/><Button Content="Profiles" Click="NavigateClick" Tag="Profiles"/><Button Content="Schedule" Click="NavigateClick" Tag="Schedule"/><Button Content="History" Click="NavigateClick" Tag="History"/><Button Content="Settings" Click="NavigateClick" Tag="Settings"/><Button Content="Logs" Click="NavigateClick" Tag="Logs"/></StackPanel><TabControl x:Name="Pages" Grid.Column="1" Margin="28,0,0,0" Background="#101827" BorderThickness="0"><TabItem Header="Dashboard"><ScrollViewer><StackPanel><TextBlock Text="Dashboard" Foreground="White" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Automation Status" Foreground="#AAB7C4" Margin="0,24,0,4"/><Border Background="#182638" Padding="18" CornerRadius="8"><StackPanel><TextBlock Text="Ready" Foreground="#72E6A5" FontSize="20"/><TextBlock Text="Next schedule: not configured" Foreground="#C9D4DF"/><TextBlock Text="Network: not checked     Location: not checked" Foreground="#C9D4DF" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="Today's Attendance" Foreground="White" FontSize="20" Margin="0,28,0,10"/><Border Background="#182638" Padding="18" CornerRadius="8"><TextBlock Text="No attendance results yet. Configure an allowed profile and real provider URLs/selectors first." Foreground="#C9D4DF" TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Run Now"/><Button Content="Retry Failed"/><Button Content="Stop Queue"/></StackPanel></StackPanel></ScrollViewer></TabItem><TabItem Header="Profiles"><StackPanel><TextBlock Text="Profiles" Foreground="White" FontSize="28"/><TextBlock Text="Manage enabled, approved attendance profiles here." Foreground="#C9D4DF" Margin="0,16"/><Button Content="Add Profile" Width="120" HorizontalAlignment="Left"/></StackPanel></TabItem><TabItem Header="Schedule"><StackPanel><TextBlock Text="Schedule" Foreground="White" FontSize="28"/><CheckBox Content="Auto Clock In" Foreground="White" Margin="0,18,0,6"/><CheckBox Content="Auto Clock Out" Foreground="White"/><TextBlock Text="Schedule persistence is applied through the EF Core settings store." Foreground="#C9D4DF" Margin="0,16"/></StackPanel></TabItem><TabItem Header="History"><TextBlock Text="History will show persisted attendance results and screenshots." Foreground="#C9D4DF"/></TabItem><TabItem Header="Settings"><StackPanel><TextBlock Text="Settings" Foreground="White" FontSize="28"/><TextBlock Text="Sensitive settings require the configured operator PIN." Foreground="#C9D4DF" Margin="0,16"/><TextBlock Text="Telegram: Enabled, Bot Token, Chat ID, notification flags, and Test Telegram are stored through the service layer." Foreground="#C9D4DF" TextWrapping="Wrap"/></StackPanel></TabItem><TabItem Header="Logs"><TextBlock Text="Logs are stored in %ProgramData%\AttendanceBot\Logs with daily rolling and secret redaction." Foreground="#C9D4DF" TextWrapping="Wrap"/></TabItem></TabControl></Grid></Window>
